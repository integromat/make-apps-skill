{
  "note": "Synthetic polling request: the provider is asked for newest-first records, the trigger declares the same order, the trigger date is parsed from a field whose format is not auto-parsed, and the output date goes through a helper that really transforms its input.",
  "providerFields": {
    "created_at": { "format": "local-datetime-no-offset" },
    "updated_at": { "format": "local-datetime-no-offset" }
  },
  "api": {
    "url": "https://api.example.invalid/v1/tickets",
    "qs": { "sort": "created_at", "direction": "desc" },
    "response": {
      "iterate": "{{body.items}}",
      "trigger": {
        "type": "date",
        "order": "desc",
        "id": "{{item.id}}",
        "date": "{{parseDate(item.created_at, 'YYYY-MM-DD HH:mm:ss', 'UTC')}}"
      },
      "output": {
        "id": "{{item.id}}",
        "updatedAt": "{{normalizeDate(item.updated_at)}}"
      }
    }
  }
}
