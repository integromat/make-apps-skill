{
  "note": "Incorrect: the request asks for newest first but the trigger declares ascending order.",
  "providerFields": {
    "created_at": { "format": "local-datetime-no-offset" },
    "updated_at": { "format": "local-datetime-no-offset" }
  },
  "api": {
    "url": "https://api.example.invalid/v1/tickets",
    "qs": { "sort": "created_at", "direction": "desc" },
    "response": {
      "iterate": "{{body.items}}",
      "trigger": {
        "type": "date",
        "order": "asc",
        "id": "{{item.id}}",
        "date": "{{parseDate(item.created_at, 'YYYY-MM-DD HH:mm:ss', 'UTC')}}"
      },
      "output": {
        "id": "{{item.id}}",
        "updatedAt": "{{normalizeDate(item.updated_at)}}"
      }
    }
  }
}
