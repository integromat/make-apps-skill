{
  "qs": {
    "is_active": true
  },
  "url": "/expense_categories",
  "method": "GET",
  "response": {
    "limit": 500,
    "output": {
      "label": "{{item.name}}",
      "value": "{{item.id}}",
      "nested": [
        {
          "name": "{{if(item.unit_price, 'units', 'total_cost')}}",
          "type": "number",
          "label": "{{if(item.unit_price, 'Units', 'Total cost')}}",
          "required": true
        }
      ]
    },
    "iterate": "{{body.expense_categories}}"
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{body.next_page}}"
  }
}
