{
  "qs": {},
  "url": "/projects/{{parameters.project_id}}//user_assignments",
  "body": {},
  "method": "GET",
  "headers": {},
  "response": {
    "limit": 500,
    "output": {
      "label": "{{item.user.name}}",
      "value": "{{item.id}}"
    },
    "iterate": "{{body.user_assignments}}"
  },
  "pagination": {
