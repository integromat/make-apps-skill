{
  "qs": {
    "user_id": "{{parameters.user_id}}"
  },
  "url": "/user_assignments",
  "method": "GET",
  "response": {
    "limit": 500,
    "output": {
      "label": "{{if(item.project.code, '[' + item.project.code + '] ' + item.project.name, item.project.name)}}",
      "value": "{{item.project.id}}"
    },
    "iterate": "{{body.user_assignments}}"
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{body.next_page}}"
  }
}
