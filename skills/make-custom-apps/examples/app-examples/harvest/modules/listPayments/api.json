{
  "qs": {
    "updated_since": "{{parameters.updated_since}}"
  },
  "url": "/invoices/{{parameters.invoice_id}}/payments",
  "method": "GET",
  "response": {
    "limit": "{{parameters.limit}}",
    "output": "{{transformResponseDates(item)}}",
    "iterate": "{{body.invoice_payments}}"
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{body.next_page}}"
  }
}
