{
  "qs": {
    "per_page": 100,
    "client_id": "{{parameters.client_id}}",
    "is_active": "{{parameters.is_active}}",
    "updated_since": "{{parameters.updated_since}}"
  },
  "url": "/projects",
  "method": "GET",
  "response": {
    "limit": "{{parameters.limit}}",
    "output": "{{transformResponseDates(item)}}",
    "iterate": "{{body.projects}}"
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{body.next_page}}"
  }
}
