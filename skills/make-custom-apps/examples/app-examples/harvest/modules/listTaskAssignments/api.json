{
  "qs": {
    "per_page": 100,
    "is_active": "{{parameters.is_active}}",
    "updated_since": "{{parameters.updated_since}}"
  },
  "url": "{{if(parameters.project_id, '/projects/' + parameters.project_id + '/task_assignments', '/task_assignments')}}",
  "body": {},
  "method": "GET",
  "headers": {},
  "response": {
    "limit": "{{parameters.limit}}",
    "output": "{{transformResponseDates(item)}}",
    "iterate": "{{body.task_assignments}}"
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{body.next_page}}"
  }
}
