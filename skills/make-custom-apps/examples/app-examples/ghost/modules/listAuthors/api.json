{
  "qs": {
    "filter": "{{filter2string(parameters.filter)}}"
  },
  "url": "/users",
  "method": "GET",
  "response": {
    "limit": "{{parameters.limit}}",
    "output": "{{item}}",
    "iterate": "{{body.users}}"
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{body.meta.pagination.next}}"
  }
}
