{
  "qs": {
    "limit": 500
  },
  "url": "/docs/{{parameters.docId}}/folders",
  "method": "GET",
  "response": {
    "output": {
      "label": "{{item.name}}",
      "value": "{{item.id}}"
    },
    "iterate": "{{body.items}}"
  },
  "pagination": {
    "qs": {
      "pageToken": "{{body.nextPageToken}}"
    },
    "condition": "{{ifempty(body.nextPageToken, false)}}"
  }
}
