{
  "qs": {
    "limit": 500,
    "valueFormat": "{{parameters.valueFormat}}"
  },
  "url": "/docs/{{parameters.docId}}/tables/{{parameters.tableIdOrName}}/rows",
  "body": {},
  "method": "GET",
  "headers": {},
  "response": {
    "limit": "{{parameters.limit}}",
    "output": "{{item}}",
    "iterate": "{{body.items}}",
    "trigger": {
      "id": "{{item.id}}",
      "date": "{{item.updatedAt}}",
      "type": "date",
      "order": "desc"
    }
  },
  "pagination": {
    "qs": {
      "pageToken": "{{body.nextPageToken}}"
    },
    "condition": "{{ifempty(body.nextPageToken, false)}}"
  }
}
