{
  "qs": {
    "limit": 500,
    "isOwner": "{{parameters.isOwner}}"
  },
  "url": "/docs",
  "body": {},
  "method": "GET",
  "headers": {},
  "response": {
    "limit": "{{parameters.limit}}",
    "output": "{{item}}",
    "iterate": "{{body.items}}",
    "trigger": {
      "id": "{{item.id}}",
      "date": "{{if(parameters.sortBy == 'updated', item.updatedAt, item.createdAt)}}",
      "type": "date",
      "order": "desc"
    }
  },
  "pagination": {
    "qs": {
      "pageToken": "{{body.nextPageToken}}"
    },
    "condition": "{{ifempty(body.nextPageToken, false)}}"
  }
}
