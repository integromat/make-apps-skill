{
  "qs": {
    "limit": "{{min(parameters.limit, 100)}}",
    "active": "{{parameters.active}}"
  },
  "url": "/payment_links",
  "method": "GET",
  "response": {
    "limit": "{{parameters.limit}}",
    "output": "{{prepareOutput(item)}}",
    "iterate": "{{body.data}}"
  },
  "pagination": {
    "qs": {
      "starting_after": "{{iterate.container.last.id}}"
    },
    "condition": "{{body.has_more}}"
  }
}
