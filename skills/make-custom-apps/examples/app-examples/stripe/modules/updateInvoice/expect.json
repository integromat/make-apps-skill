    "type": "text",
    "label": "Description"
  },
  {
    "name": "metadata",
    "spec": [
      {
        "name": "key",
        "type": "text",
        "label": "Key",
        "required": true
      },
      {
        "name": "value",
        "type": "text",
        "label": "Value"
      }
    ],
    "type": "array",
    "label": "Metadata"
  },
  {
