              "label": "Charge Automatically",
              "value": "charge_automatically"
            },
            {
              "label": "Send Invoice",
              "value": "send_invoice"
            }
          ]
        }
      ]
    },
    "help": "The identifier of the desired invoice.",
    "name": "invoice",
    "type": "text",
    "label": "Invoice ID",
    "required": true
  },
  {
    "help": "Controls whether Stripe will perform automatic collection of the invoice.",
    "name": "auto_advance",
    "type": "boolean",
    "label": "Auto Advance",
    "required": true
  },
  {
    "name": "collection_method",
    "type": "select",
    "label": "Collection Method",
    "default": "charge_automatically",
    "options": [
      {
        "label": "Charge Automatically",
        "value": "charge_automatically"
      },
      {
        "label": "Send Invoice",
        "value": "send_invoice",
