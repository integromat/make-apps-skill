    "advanced": true,
    "validate": {
      "maxItems": 4
    }
  },
  {
    "name": "default_payment_method",
    "type": "text",
    "label": "Default Payment Method ID",
    "advanced": true
  },
  {
    "name": "default_source",
    "type": "text",
    "label": "Default Payment Source ID",
    "advanced": true
  },
  {
    "name": "default_tax_rates",
    "type": "text",
    "label": "Default Tax Rates ID",
    "advanced": true
  },
  {
    "name": "discounts",
    "spec": [
      {
        "name": "coupon",
        "type": "select",
        "label": "Coupon ID",
        "options": "rpc://app%23stripe@1/listCoupons"
      },
      {
        "help": "An existing discount ID on the object (or one of its ancestors) to reuse.",
        "name": "discount",
        "type": "text",
        "label": "Discount ID"
      }
    ],
    "type": "array",
    "label": "Discounts",
    "advanced": true
  },
  {
    "name": "footer",
    "type": "text",
    "label": "Footer",
    "advanced": true
  },
  {
    "help": "If not specified and this invoice is part of a subscription, the default `statement_descriptor` will be set to the first subscription item’s product’s `statement_descriptor`.",
    "name": "statement_descriptor",
    "type": "text",
    "label": "Statement Descriptor",
    "advanced": true
  },
  {
    "name": "transfer_data",
    "spec": [
      {
        "name": "destination",
        "type": "select",
        "label": "Destination",
        "options": "rpc://app%23stripe@1/listConnectedAccounts",
        "editable": true
      },
      {
        "name": "amount",
        "type": "uinteger",
        "label": "Amount"
      }
    ],
    "type": "collection",
    "label": "Transfer Data",
    "advanced": true
  }
