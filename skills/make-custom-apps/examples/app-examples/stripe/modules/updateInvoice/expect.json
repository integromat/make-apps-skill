                  {
                    "label": "Trialing",
                    "value": "trialing"
                  },
                  {
                    "label": "Ended",
                    "value": "ended"
                  }
                ]
              }
            ]
          },
          "name": "subscription",
          "type": "text",
          "label": "Subscription ID"
