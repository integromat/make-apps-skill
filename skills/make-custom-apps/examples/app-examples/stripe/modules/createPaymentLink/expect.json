[
  {
    "name": "line_items",
    "spec": [
      {
        "mode": "edit",
        "name": "price",
        "type": "select",
        "label": "Price",
        "options": "rpc://app%23stripe@1/listPrices",
        "editable": true,
        "required": true
      },
      {
        "name": "quantity",
        "type": "uinteger",
        "label": "Quantity",
        "required": true
      },
      {
        "name": "adjustable_quantity",
        "spec": [
          {
            "name": "enabled",
            "type": "boolean",
            "label": "Enabled",
            "nested": [
              {
                "name": "minimum",
                "type": "uinteger",
                "label": "Minimum",
                "validate": {
                  "max": 98
                }
              },
              {
                "name": "maximum",
                "type": "uinteger",
                "label": "Maximum",
                "validate": {
                  "max": 99
                }
              }
            ],
            "required": true
          }
        ],
        "type": "collection",
        "label": "Adjustable Quantity"
      }
    ],
    "type": "array",
    "label": "Line Items",
    "required": true
  },
