  {
    "name": "after_completion",
    "spec": [
      {
        "help": "`Redirect`: Redirects the customer to the specified url after the purchase is complete.\n\n`Hosted Confirmation`: Displays a message on the hosted surface after the purchase is complete.",
        "name": "type",
        "type": "select",
        "label": "Type",
        "options": [
          {
            "label": "Redirect",
            "value": "redirect",
            "nested": [
              {
                "name": "redirect",
                "spec": [
                  {
                    "help": "The URL the customer will be redirected to after the purchase is complete. You can embed `{CHECKOUT_SESSION_ID}` into the URL to have the id of the completed checkout session included.",
                    "name": "url",
                    "type": "url",
                    "label": "URL",
                    "required": true
                  }
                ],
                "type": "collection",
                "label": "Redirect"
              }
            ]
          },
          {
            "label": "Hosted Confirmation",
            "value": "hosted_confirmation",
            "nested": [
              {
                "name": "hosted_confirmation",
                "spec": [
                  {
                    "name": "custom_message",
                    "type": "text",
                    "label": "Custom Message"
                  }
                ],
                "type": "collection",
                "label": "Hosted Confirmation"
              }
            ]
          }
        ]
      }
    ],
    "type": "collection",
    "label": "After Completion",
    "advanced": true
  },
