  {
    "help": "__[Stripe Connect Only]__ The amount of the application fee (if any) that will be requested to be applied to the payment and transferred to the application owner's Stripe account. Can only be applied when there are no line items with recurring prices.",
    "name": "application_fee_amount",
    "type": "uinteger",
    "label": "Application Fee Amount",
    "advanced": true
  },
  {
    "help": "__[Stripe Connect Only]__ This represents the percentage of the subscription invoice subtotal that will be transferred to the application owner’s Stripe account. There must be at least 1 line item with a recurring price to use this field.",
    "name": "application_fee_percent",
    "type": "number",
    "label": "Application Fee Percent",
    "advanced": true,
    "validate": {
      "max": 100,
      "min": 0
    }
  },
  {
    "help": "__[Stripe Connect Only]__ The account on behalf of which to charge.",
    "name": "on_behalf_of",
    "type": "select",
    "label": "On Behalf Of",
    "options": "rpc://app%23stripe@1/listConnectedAccounts",
    "editable": true
  },
  {
    "name": "transfer_data",
    "spec": [
      {
        "help": "__[Stripe Connect Only]__ If specified, successful charges will be attributed to the destination account for tax reporting, and the funds from charges will be transferred to the destination account.",
        "name": "destination",
        "type": "select",
        "label": "Destination",
        "options": "rpc://app%23stripe@1/listConnectedAccounts",
        "editable": true
      },
      {
        "help": "__[Stripe Connect Only]__ The amount that will be transferred automatically when a charge succeeds.",
        "name": "amount",
        "type": "number",
        "label": "Amount"
      }
    ],
    "type": "collection",
    "label": "Transfer Data",
    "advanced": true
  }
