{
  "url": "/orgs/current/workspaces",
  "method": "GET",
  "response": {
    "limit": "{{parameters.limit}}",
    "output": "{{item}}",
    "iterate": "{{body}}",
    "trigger": {
      "id": "{{item.id}}",
      "date": "{{if(parameters.event, item.updatedAt, item.createdAt)}}",
      "type": "date",
      "order": "desc"
    }
  }
}
