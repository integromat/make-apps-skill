  "method": "GET",
  "headers": {
    "X-Airtable-Client-Secret": "{{common.metadataClientSecret}}"
  },
  "response": {
    "limit": "{{parameters.limit}}",
    "output": "{{item}}",
    "iterate": "{{body.tables}}"
  }
}
