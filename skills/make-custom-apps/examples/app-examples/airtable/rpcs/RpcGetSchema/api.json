{
  "url": "https://api.airtable.com/v0/meta/bases/{{parameters.base}}/tables",
  "headers": {
    "X-Airtable-Client-Secret": "{{common.metadataClientSecret}}"
  },
  "response": {
    "output": "{{getSchema(body, parameters.table, parameters.for, parameters.filter, parameters.useColumnId, parameters.fields)}}",
    "wrapper": "{{wrapOutput(output, parameters.for)}}"
  }
}
