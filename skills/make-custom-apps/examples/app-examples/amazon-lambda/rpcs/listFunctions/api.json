{
  "qs": {
    "MaxItems": 1000,
    "FunctionVersion": "ALL"
  },
  "url": "/2015-03-31/functions/",
  "method": "GET",
  "response": {
    "output": {
      "label": "{{item.FunctionName + ' (' + item.Version + ')'}}",
      "value": "{{item.FunctionName}}"
    },
    "iterate": "{{body.Functions}}"
  },
  "pagination": {
    "qs": {
      "Marker": "{{body.NextMarker}}"
    },
    "condition": "{{ifempty(body.NextMarker, false)}}"
  }
}
