[
  {
    "name": "select_or_manual",
    "type": "select",
    "label": "Enter a Card ID and Checklist Item ID",
    "options": [
      {
        "label": "Enter manually",
        "value": "manual",
        "nested": [
          {
            "name": "card_id",
            "type": "text",
            "label": "Card ID",
            "required": true
          },
          {
            "name": "idCheckItem",
            "type": "text",
            "label": "Checklist Item ID",
            "required": true
          },
          {
            "help": "Move the item to a new checklist on the same card.",
            "name": "idChecklist",
            "type": "text",
            "label": "Checklist ID"
          }
        ],
        "default": true
      },
      {
        "label": "Select",
        "value": "select",
        "nested": [
          {
            "name": "board_id",
            "type": "select",
            "label": "Board",
            "options": {
              "store": "rpc://listBoards",
              "nested": [
                {
                  "name": "list_id",
                  "type": "select",
                  "label": "List",
                  "options": {
                    "store": "rpc://getBoardsLists",
                    "nested": [
                      {
                        "name": "card_id",
                        "type": "select",
                        "label": "Card",
                        "options": {
                          "store": "rpc://getIDcardsUnderList",
                          "nested": [
                            {
                              "name": "checklist_id",
                              "type": "select",
                              "label": "Checklist",
                              "options": {
                                "store": "rpc://getIDchecklistOnCard",
                                "nested": [
                                  {
                                    "name": "idCheckItem",
                                    "type": "select",
                                    "label": "Checlist Item",
                                    "options": "rpc://getChecklistItems",
                                    "mappable": false,
                                    "required": true
                                  }
                                ]
                              },
                              "mappable": false,
                              "required": true
                            },
                            {
                              "name": "idChecklist",
                              "type": "select",
                              "label": "Move to Checklist",
                              "options": "rpc://getIDchecklistOnCard"
                            }
                          ]
                        },
                        "mappable": false,
                        "required": true
                      }
                    ]
                  },
                  "mappable": false,
                  "required": true
                }
              ]
            },
            "mappable": false,
            "required": true
          }
        ]
      }
    ],
    "mappable": false,
    "required": true
  },
  {
    "name": "name",
    "type": "text",
    "label": "Item name"
  },
  {
    "name": "pos",
    "type": "select",
    "label": "Position",
    "options": [
      {
        "label": "To the top",
        "value": "top"
      },
      {
        "label": "Bottom",
        "value": "bottom"
      }
    ]
  },
  {
    "name": "state",
    "type": "select",
    "label": "State",
    "options": [
      {
        "label": "Complete",
        "value": "complete"
      },
      {
        "label": "Incomplete",
        "value": "incomplete"
      }
    ]
  }
]
