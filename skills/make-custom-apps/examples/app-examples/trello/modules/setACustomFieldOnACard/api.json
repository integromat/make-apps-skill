    "method": "PUT",
    "headers": {},
    "response": {
      "output": "{{body}}"
    },
    "condition": "{{if(parameters.manual_or_select === 'select', if(getType(metadata.expect) === 'map', parameters.type, getType(metadata.expect)), parameters.type) === 'list'}}"
