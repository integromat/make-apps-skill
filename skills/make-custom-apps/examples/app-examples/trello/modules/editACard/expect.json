[
  {
    "name": "manual_or_select",
    "type": "select",
    "label": "Enter Card ID",
    "options": [
      {
        "label": "Enter manually",
        "value": "manual",
        "nested": [
          {
            "name": "card_id",
            "type": "text",
            "label": "Card ID",
