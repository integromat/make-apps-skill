          }
        ],
        "default": true
      },
      {
        "label": "Select",
        "value": "select",
        "nested": [
          {
            "name": "board_id",
            "type": "select",
            "label": "Board",
            "options": {
              "store": "rpc://app%23trello@4/listBoards",
              "nested": [
                {
                  "name": "list_id",
                  "type": "select",
                  "label": "List",
                  "options": {
                    "store": "rpc://app%23trello@4/getBoardsLists",
                    "nested": [
                      {
                        "name": "card_id",
                        "type": "select",
                        "label": "Card",
                        "options": "rpc://app%23trello@4/getIDcardsUnderList",
                        "mappable": false,
                        "required": true
                      }
                    ]
                  },
                  "mappable": false,
                  "required": true
                }
              ]
            },
            "mappable": false,
            "required": true
          }
        ]
      }
    ],
    "mappable": false,
    "required": true
  },
  {
    "help": "The new name for the card.",
    "name": "name",
    "type": "text",
    "label": "New name"
  },
  {
    "help": "The new description for the card.",
    "name": "description",
    "type": "text",
    "label": "New description",
    "validate": {
      "max": 16384
    }
  },
  {
    "name": "moveCard",
    "type": "select",
    "label": "Move a card",
    "options": [
      {
        "label": "To a board",
        "value": "boardOnly",
        "nested": [
          {
            "help": "The card will be moved to the first list on the board.",
            "mode": "edit",
            "name": "idBoard",
            "type": "select",
            "label": "Board ID",
            "options": "rpc://app%23trello@4/listBoards"
          }
        ]
      },
      {
        "label": "To a board and list",
        "value": "boardAndList",
        "nested": [
          {
            "mode": "edit",
            "name": "idBoard",
            "type": "select",
            "label": "Board ID",
            "options": {
              "store": "rpc://app%23trello@4/listBoards",
              "nested": [
                {
                  "name": "idList",
                  "type": "select",
                  "label": "List ID",
                  "options": "rpc://app%23trello@4/getBoardLists2"
                }
              ]
            }
          }
        ]
      }
    ],
    "mappable": false
  },
