                        "type": "select",
                        "label": "Card",
                        "options": "rpc://getIDcardsUnderList",
                        "mappable": false,
                        "required": true
                      }
                    ]
                  },
                  "mappable": false,
                  "required": true
                }
              ]
            },
            "mappable": false,
            "required": true
          }
        ]
      }
    ],
    "mappable": false,
    "required": true
  },
  {
    "name": "name",
    "type": "text",
    "label": "Name",
    "required": true,
    "validate": {
      "max": 16384
    }
  },
  {
    "name": "position",
    "type": "select",
    "label": "Position",
    "options": [
      {
        "label": "To the top",
        "value": "top"
      },
      {
        "label": "Bottom",
        "value": "bottom"
      }
    ],
    "editable": true
  },
  {
