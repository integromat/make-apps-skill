{
  "qs": {
    "count": "{{min(parameters.limit, 1000)}}",
    "sort_dir": "DESC",
    "sort_field": "added_date"
  },
  "url": "/file-manager/files",
  "method": "GET",
  "response": {
    "limit": "{{parameters.limit}}",
    "output": "{{generalResponse(item)}}",
    "iterate": "{{body.files}}",
    "trigger": {
      "id": "{{item.id}}",
      "date": "{{item.created_at}}",
      "type": "date",
      "order": "desc"
    }
  },
  "pagination": {
    "qs": {
      "offset": "{{(pagination.page - 1) * 1000}}"
    },
    "condition": "{{parameters.limit >= 1000 && length(body.files) === 1000}}"
  }
}
