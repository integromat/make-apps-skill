{
  "qs": {
    "count": 100
  },
  "url": "/reports/{{parameters.campaign_id}}/click-details",
  "method": "GET",
  "response": {
    "limit": "{{parameters.limit}}",
    "output": "{{generalResponse(item)}}",
    "iterate": "{{body.urls_clicked}}"
  },
  "pagination": {
    "qs": {
      "offset": "{{(pagination.page - 1) * 100}}"
    }
  }
}
