[
  {
    "name": "listId",
    "type": "select",
    "label": "List ID",
    "options": {
      "store": "rpc://app%23mailchimp@2/listLists",
      "nested": [
        {
          "name": "select",
          "type": "select",
          "label": "Select",
          "options": [
            {
              "label": "Email",
              "value": "email_address",
              "nested": [
                {
                  "name": "email",
                  "type": "select",
                  "label": "Email",
                  "options": "rpc://app%23mailchimp@2/listSubscribersEmailAddress",
                  "required": true
                }
              ]
            },
            {
              "label": "Contact ID",
              "value": "contact_id",
              "nested": [
                {
                  "name": "contact_id",
                  "type": "select",
                  "label": "Contact ID",
                  "options": "rpc://app%23mailchimp@2/listSubscribersContactId",
                  "required": true
                }
              ]
            }
          ],
          "mappable": false,
          "required": true
        },
        {
          "name": "add/updateMergeFields",
          "type": "boolean",
          "label": "Add/Updated Merge Fields",
          "nested": [
            "rpc://app%23mailchimp@2/getMergeFieldsParams"
          ]
        },
        {
          "name": "interest_category_id",
          "type": "select",
          "label": "Interest Category",
          "options": {
            "store": "rpc://app%23mailchimp@2/listCategoriesIDs",
            "nested": [
              "rpc://app%23mailchimp@2/listInterestsIDs"
            ]
          }
        }
      ]
    },
    "required": true
  },
  {
    "help": "If `Skip Merge Validation` is `true`, member data will be accepted without merge field values, even if the merge field is usually required. This defaults to `false`.",
    "name": "skip_merge_validation",
    "type": "boolean",
    "label": "Skip Merge Validation",
    "default": false
  },
  {
    "help": "Email address for a subscriber. This value is required only if the email address is not already present on the list.",
    "name": "email_address",
    "type": "email",
    "label": "Email Address"
  },
  {
