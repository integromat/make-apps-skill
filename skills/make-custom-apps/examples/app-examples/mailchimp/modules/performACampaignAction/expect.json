            "required": true
          },
          {
            "name": "send_type",
            "type": "select",
            "label": "Type",
            "options": [
              {
                "label": "HTML",
                "value": "html",
                "default": true
              },
              {
                "label": "Plain Text",
                "value": "plaintext"
              }
            ],
            "required": true
          }
        ]
      },
      {
        "label": "Resend a campaign",
        "value": "create-resend"
      }
