{
  "qs": {
    "count": 100,
    "status": "subscribed",
    "sort_dir": "DESC",
    "sort_field": "last_changed"
  },
  "url": "/lists/{{parameters.list}}/members",
  "method": "GET",
  "response": {
    "limit": 300,
    "output": {
      "label": "{{item.full_name + ': ' + item.id}}",
      "value": "{{item.id}}"
    },
    "iterate": "{{body.members}}"
  },
  "pagination": {
    "qs": {
      "offset": "{{(pagination.page - 1) * 100}}"
    }
  }
}
