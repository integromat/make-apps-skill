{
  "qs": {
    "count": 100
  },
  "url": "/ecommerce/stores/{{parameters.store_id}}/customers",
  "method": "GET",
  "response": {
    "limit": 300,
    "output": {
      "label": "{{item.first_name + item.last_name || item.email_address}}",
      "value": "{{item.id}}"
    },
    "iterate": "{{body.customers}}"
  },
  "pagination": {
    "qs": {
      "offset": "{{(pagination.page - 1) * 100}}"
    }
  }
}
