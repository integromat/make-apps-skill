{
  "qs": {
    "count": 100
  },
  "url": "/lists/{{parameters.listId}}/interest-categories/{{parameters.interest_category_id}}/interests",
  "method": "GET",
  "response": {
    "output": {
      "name": "interests",
      "spec": "{{getInterestsParams(body.interests)}}",
      "type": "collection",
      "label": "Interests"
    }
  },
  "pagination": {
    "qs": {
      "offset": "{{(pagination.page - 1) * 100}}"
    }
  }
}
