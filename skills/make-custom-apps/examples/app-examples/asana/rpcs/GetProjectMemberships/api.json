{
  "qs": {
    "limit": 100,
    "opt_fields": [
      "this.user.name",
      "this.project.name"
    ]
  },
  "url": "/projects/{{parameters.project_gid}}/project_memberships",
  "method": "GET",
  "response": {
    "limit": 300,
    "output": {
      "label": "[{{item.project.name}}] {{item.user.name}}",
      "value": "{{item.gid}}"
    },
    "iterate": "{{body.data}}"
  },
  "pagination": {
    "qs": {
      "offset": "{{body.next_page.offset}}"
    },
    "condition": "{{ifempty(body.next_page, false)}}"
  }
}
