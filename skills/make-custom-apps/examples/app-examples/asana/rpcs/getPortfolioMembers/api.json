{
  "url": "/portfolios/{{parameters.portfolio}}",
  "method": "GET",
  "response": {
    "output": {
      "label": "{{item.name}}",
      "value": "{{item.gid}}"
    },
    "iterate": "{{body.data.members}}"
  },
  "pagination": {
    "qs": {
      "offset": "{{body.next_page.offset}}"
    },
    "condition": "{{ifempty(body.next_page, false)}}"
  }
}
