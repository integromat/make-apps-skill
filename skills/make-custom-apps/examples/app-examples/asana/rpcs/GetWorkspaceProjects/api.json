{
  "qs": {
    "limit": 100,
    "workspace": "{{parameters.workspace}}",
    "opt_fields": [
      "this.workspace.name",
      "this.name"
    ]
  },
  "url": "/projects",
  "method": "GET",
  "response": {
    "limit": 1100,
    "output": {
      "label": "{{item.name}}",
      "value": "{{item.gid}}"
    },
    "iterate": "{{body.data}}"
  },
  "pagination": {
    "qs": {
      "offset": "{{body.next_page.offset}}"
    },
    "condition": "{{ifempty(body.next_page, false)}}"
  }
}
