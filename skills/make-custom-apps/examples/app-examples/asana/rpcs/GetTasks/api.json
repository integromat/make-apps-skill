{
  "qs": {
    "tag": "{{ifempty(parameters.tag,undefined)}}",
    "limit": 100,
    "project": "{{if(parameters.section === undefined,parameters.project,undefined)}}",
    "section": "{{ifempty(parameters.section,undefined)}}",
    "assignee": "{{ifempty(parameters.assigneeId,ifempty(parameters.assignee,undefined))}}",
    "workspace": "{{ifempty(parameters.workspace,undefined)}}"
  },
  "url": "/tasks",
  "method": "GET",
  "response": {
    "limit": 300,
    "output": {
      "label": "{{item.name}}",
      "value": "{{item.gid}}"
    },
    "iterate": "{{body.data}}"
  },
  "pagination": {
    "qs": {
      "offset": "{{body.next_page.offset}}"
    },
    "condition": "{{ifempty(body.next_page, false)}}"
  }
}
