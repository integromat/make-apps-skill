{
  "qs": {
    "limit": 100,
    "workspace": "{{ifempty(parameters.workspace,ifempty(parameters.workspaceAlt,parameters.workspaceAlt2))}}",
    "opt_fields": [
      "this.name"
    ]
  },
  "url": "/users",
  "method": "GET",
  "response": {
    "limit": 300,
    "output": {
      "label": "{{item.name}}",
      "value": "{{item.gid}}"
    },
    "iterate": "{{body.data}}"
  },
  "pagination": {
    "qs": {
      "offset": "{{body.next_page.offset}}"
    },
    "condition": "{{ifempty(body.next_page, false)}}"
  }
}
