{
  "qs": "{{setOptFields(omit(setLimit(parameters),'choice','task_gid','workspace','assignee','project','section','tag','page','selectOrMap'),'Task')}}",
  "url": "/tasks/{{parameters.task_gid}}/subtasks",
  "method": "GET",
  "response": {
    "limit": "{{parameters.page}}",
    "output": "{{customFieldExtra(item)}}",
    "iterate": "{{body.data}}"
  },
  "pagination": {
    "qs": {
      "offset": "{{body.next_page.offset}}"
    },
    "condition": "{{ifempty(body.next_page, false)}}"
  }
}
