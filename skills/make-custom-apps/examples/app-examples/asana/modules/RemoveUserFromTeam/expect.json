[
  {
    "name": "selectOrMap",
    "sort": "text",
    "type": "select",
    "label": "Enter a Team ID",
    "default": "map",
    "options": [
      {
        "label": "Select from the list",
        "value": "select",
        "nested": [
          {
            "help": "Filter on workspaces or organizations.",
