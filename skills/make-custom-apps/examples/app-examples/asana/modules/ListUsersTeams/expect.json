[
  {
    "help": "Select a workspace to generate the workspace's users.",
    "name": "workspaceAlt",
    "type": "select",
    "label": "Workspace ID",
    "options": {
      "store": "rpc://app%23asana@2/GetWorkspaces",
      "nested": [
        {
          "mode": "edit",
          "name": "user_gid",
          "type": "select",
          "label": "User ID",
          "options": "rpc://app%23asana@2/GetWorkspaceUsers",
          "required": true
        }
      ]
    }
  },
  {
    "help": "Filter on workspaces or organizations.",
    "name": "organization",
    "type": "select",
    "label": "Workspace/Organization ID",
    "options": "rpc://app%23asana@2/GetWorkspaces",
    "required": true
  },
  {
    "help": "The maximum number of results to be worked with during one execution cycle.",
    "name": "page",
    "type": "uinteger",
    "label": "Limit",
    "default": 10
  }
]
