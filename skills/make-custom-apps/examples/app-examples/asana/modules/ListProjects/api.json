{
  "qs": "{{setOptFields(if(parameters.workspace == undefined,omit(parameters,'page'),omit(setLimit(parameters),'page')),'Project')}}",
  "url": "/projects",
  "method": "GET",
  "response": {
    "limit": "{{parameters.page}}",
    "output": "{{customFieldExtra(item)}}",
    "iterate": "{{body.data}}"
  },
  "pagination": {
    "qs": {
      "offset": "{{body.next_page.offset}}"
    },
    "condition": "{{ifempty(body.next_page, false)}}"
  }
}
