{
  "rev": 5,
  "crud": "read",
  "epoch": {
    "qs": {
      "team": "{{ifempty(parameters.team,undefined)}}",
      "limit": "{{if(parameters.workspace,50,undefined)}}",
      "archived": "{{ifempty(parameters.archived,undefined)}}",
      "workspace": "{{ifempty(parameters.workspace,undefined)}}",
      "opt_fields": [
        "this.workspace.name",
        "this.name",
        "this.created_at"
      ]
    },
    "response": {
      "limit": 300,
      "output": {
        "date": "{{item.created_at}}",
        "label": "[{{item.workspace.name}}] {{item.name}}"
      }
    },
    "pagination": {
      "qs": {
        "offset": "{{body.next_page.offset}}"
      },
      "condition": "{{ifempty(body.next_page, false)}}"
    }
  },
  "flags": {},
  "label": "Watch New Projects",
  "scope": [],
  "public": true,
  "typeId": 1,
  "hookName": null,
  "learning": false,
  "deprecated": false,
  "accountName": "asana2",
  "description": "Checks whether new projects have been made.",
  "altAccountName": null
}
