  {
    "help": "Select a workspace to generate the workspace's users (potential assignees).",
    "mode": "edit",
    "name": "workspaceAlt",
    "type": "select",
    "label": "Workspace ID",
    "options": {
      "store": "rpc://app%23asana@2/GetWorkspaces",
      "nested": [
        {
          "name": "assignee",
          "type": "select",
          "label": "Task Assignee ID",
          "options": {
            "store": "rpc://app%23asana@2/GetWorkspaceUsers",
            "nested": [
              {
                "help": "Setting this field to inbox or upcoming inserts it at the top of the section, while the other options will insert at the bottom.",
                "name": "assignee_status",
                "type": "select",
                "label": "Assignee Status",
                "options": [
                  {
                    "label": "Inbox",
                    "value": "inbox"
                  },
                  {
                    "label": "Later",
                    "value": "later"
                  },
                  {
                    "label": "Today",
                    "value": "today"
                  },
                  {
                    "label": "Upcoming",
                    "value": "upcoming"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
  {
    "help": "The due can be a date or a date time combination.",
    "name": "due",
    "type": "select",
    "label": "Due",
    "options": [
      {
        "label": "Date",
        "value": "date",
        "nested": [
          {
            "help": "Date on which this task is due, the time factor will be ignored.",
            "name": "due_on",
            "type": "date",
            "label": "Due On"
          },
          {
            "help": "Date on which the task starts, the time factor will be ignored. The due date must be present in order to set the Start On field.",
            "name": "start_on",
            "type": "date",
            "label": "Start On"
          }
        ]
      },
      {
        "label": "Date Time Combination",
        "value": "datetime",
        "nested": [
          {
            "help": "Date and time on which this task is due.",
            "name": "due_at",
            "type": "date",
            "label": "Due At"
          },
          {
            "help": "Date on which the task starts, the time factor will be ignored. The due date must be present in order to set the Start On field.",
            "name": "start_on",
            "type": "date",
            "label": "Start On"
          }
        ]
      }
    ]
  },
  {
    "help": "Default Task is the default type.\nMilestones can't have a start date.\nApprovals are only available for users in an Enterprise or Business plan.",
