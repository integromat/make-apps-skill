    "type": "select",
    "label": "Resource Subtype",
    "options": [
      {
        "label": "Approval",
        "value": "approval"
      },
      {
        "label": "Default Task",
        "value": "default_task"
      },
      {
        "label": "Milestone",
        "value": "milestone"
      }
