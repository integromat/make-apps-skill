{
  "url": "https://reports.api.clockify.me/v1/workspaces/{{parameters.workspace}}/reports/summary",
  "body": {
    "tags": "{{ifObjEmpty(parameters.tags)}}",
    "tasks": "{{ifObjEmpty(parameters.tasks)}}",
    "users": "{{ifObjEmpty(parameters.users)}}",
    "amounts": "{{parameters.amounts}}",
    "clients": "{{ifObjEmpty(parameters.clients)}}",
    "billable": "{{parameters.billable}}",
    "projects": "{{ifObjEmpty(parameters.projects)}}",
    "rounding": "{{parameters.rounding}}",
    "timeZone": "{{parameters.timeZone}}",
    "sortOrder": "{{parameters.sortOrder}}",
    "exportType": "{{parameters.exportType}}",
    "userGroups": "{{ifObjEmpty(parameters.userGroups)}}",
    "amountShown": "{{parameters.amountShown}}",
    "description": "{{parameters.description}}",
    "customFields": "{{parameters.customFields}}",
    "dateRangeEnd": "{{parameters.dateRangeEnd}}",
    "approvalState": "{{parameters.approvalState}}",
    "summaryFilter": "{{parameters.summaryFilter}}",
    "dateRangeStart": "{{parameters.dateRangeStart}}",
    "invoicingState": "{{parameters.invoicingState}}",
    "withoutDescription": "{{parameters.withoutDescription}}"
  },
  "method": "POST",
  "response": {
    "type": "{{if(parameters.exportType === 'CSV' || parameters.exportType === 'XLSX' || parameters.exportType === 'PDF', \"binary\", \"json\")}}",
    "output": "{{if(parameters.exportType === 'CSV' || parameters.exportType === 'XLSX' || parameters.exportType === 'PDF', null, body)}}"
  }
}
