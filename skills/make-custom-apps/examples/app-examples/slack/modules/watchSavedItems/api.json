{
  "url": "/stars.list",
  "method": "GET",
  "response": {
    "limit": "{{parameters.limit}}",
    "output": "{{getOutput(item)}}",
    "iterate": "{{body.items}}",
    "trigger": {
      "id": "{{item.date_create}}",
      "date": "{{parseDate(item.date_create)}}",
      "type": "date",
      "order": "desc"
    }
  },
  "pagination": {
    "qs": {
      "cursor": "{{body.response_metadata.next_cursor}}"
    },
    "condition": "{{body.response_metadata.next_cursor}}"
  }
}
