{
  "qs": {},
  "url": "/users.list",
  "body": {},
  "method": "GET",
  "headers": {},
  "response": {
    "error": {
      "type": "DataError",
      "message": "{{getErrorMessage(body, statusCode)}}"
    },
    "limit": "{{parameters.limit}}",
    "output": {
      "label": "{{item.name}}",
      "value": "{{item.id}}"
    },
    "iterate": "{{sort(body.members, 'name')}}"
  },
  "pagination": {
    "qs": {
      "cursor": "{{body.response_metadata.next_cursor}}"
    },
    "condition": "{{body.response_metadata.next_cursor}}"
  }
}
